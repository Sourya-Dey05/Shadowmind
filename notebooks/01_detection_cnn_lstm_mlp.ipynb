{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# ShadowMind — AI Detection Engine Training & Evaluation\n",
    "### CNN (Spatial) + LSTM (Temporal) + MLP (Fusion Ensemble)\n",
    "\n",
    "This notebook trains and evaluates the core detection engine on network traffic flows and generates classification metrics (Accuracy, Precision, Recall, F1-Score, Confusion Matrix)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "import torch\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics import accuracy_score, precision_recall_fscore_support, confusion_matrix\n",
    "\n",
    "# Ensure project root is on path\n",
    "ROOT = Path('.').resolve()\n",
    "if str(ROOT) not in sys.path:\n",
    "    sys.path.insert(0, str(ROOT))\n",
    "\n",
    "from src.data.preprocessor import load_and_prepare\n",
    "from src.detection.engine import DetectionEngine\n",
    "\n",
    "print(\"PyTorch version:\", torch.__version__)\n",
    "print(\"CUDA available:\", torch.cuda.is_available())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data & Prepare Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data = load_and_prepare()\n",
    "\n",
    "X_train, X_test = data[\"X_train\"], data[\"X_test\"]\n",
    "y_train, y_test = data[\"y_train\"], data[\"y_test\"]\n",
    "X_train_seq, X_test_seq = data[\"X_train_seq\"], data[\"X_test_seq\"]\n",
    "y_train_seq, y_test_seq = data[\"y_train_seq\"], data[\"y_test_seq\"]\n",
    "\n",
    "print(f\"Train samples: {len(X_train)}, Test samples: {len(X_test)}\")\n",
    "print(f\"Test labels distribution:\", np.bincount(y_test))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Initialize & Load Trained Detection Engine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "engine = DetectionEngine()\n",
    "engine.load_weights()\n",
    "print(\"Engine loaded on device:\", engine.device)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Generate Evaluation Metrics on Test Set"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "engine.set_eval_mode()\n",
    "\n",
    "# Align sizes\n",
    "min_test = min(len(X_test), len(X_test_seq), len(y_test))\n",
    "t_flat = torch.tensor(X_test[:min_test], dtype=torch.float32).to(engine.device)\n",
    "t_seq  = torch.tensor(X_test_seq[:min_test], dtype=torch.float32).to(engine.device)\n",
    "t_y    = y_test[:min_test]\n",
    "\n",
    "with torch.no_grad():\n",
    "    c_emb = engine.cnn(t_flat)\n",
    "    l_emb = engine.lstm(t_seq)\n",
    "    preds_tensor = engine.mlp(c_emb, l_emb)\n",
    "\n",
    "scores = preds_tensor.cpu().numpy().flatten()\n",
    "pred_labels = (scores >= 0.5).astype(int)\n",
    "\n",
    "# Calculate metrics\n",
    "acc = accuracy_score(t_y, pred_labels)\n",
    "precision, recall, f1, _ = precision_recall_fscore_support(t_y, pred_labels, average='binary', zero_division=0)\n",
    "cm = confusion_matrix(t_y, pred_labels)\n",
    "\n",
    "print(\"=== SHADOWMIND DETECTION ENGINE PERFORMANCE ==-\")\n",
    f"print(f\"Accuracy:  {acc * 100:.2f}%\")\n",
    f"print(f\"Precision: {precision:.4f}\")\n",
    f"print(f\"Recall:    {recall:.4f}\")\n",
    f"print(f\"F1-Score:  {f1:.4f}\")\n",
    "print(\"\\nConfusion Matrix:\")\n",
    "print(cm)"
   ]
  }
 ],
