# =============================================================================
# .gitignore — ShadowMind
# Prevents secrets, build artifacts, and sensitive data from being committed.
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets ---
.env
.env.*
*.env
secrets.yaml
secrets.json

# --- Trained model weights (large binaries — use DVC or release assets) ---
models/**/*.pt
models/**/*.pth
models/**/*.h5

# --- Data (raw captures may contain sensitive traffic) ---
data/raw/
data/processed/*.csv
data/processed/*.json

# --- Logs ---
logs/
*.log

# --- OS artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.suo
*.user

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- PyInstaller ---
*.spec
dist/
build/

# --- SQLite vault database (contains encrypted file metadata) ---
*.db
*.sqlite
*.sqlite3

# --- Coverage / test artifacts ---
.coverage
htmlcov/
.pytest_cache/
